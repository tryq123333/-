+    private void toggleNoteRoll() {
+        if (Looper.myLooper() != Looper.getMainLooper()) {
+            mainHandler.post(this::toggleNoteRoll);
+            return;
+        }
+        if (noteRollView != null) {
+            removeOverlay(noteRollView);
+            noteRollView = null;
+            prefs.edit().putBoolean("note_roll_enabled", false).apply();
+            toast("音符谱面已隐藏。再次点“谱面”可显示。 ");
+        } else {
+            prefs.edit().putBoolean("note_roll_enabled", true).apply();
+            showNoteRoll();
+        }
+    }
+
+    private MidiParser.MidiSong readCurrentSong() {
+        String path = prefs.getString(MainActivity.KEY_SONG_PATH, "");
+        if (path == null || path.isEmpty() || !new File(path).isFile()) return null;
+        try { return MidiParser.parse(new File(path)); }
+        catch (Exception ex) { toast("谱面载入失败：" + ex.getMessage()); return null; }
+    }
+
+    private void showNoteRoll() {
+        if (Looper.myLooper() != Looper.getMainLooper()) {
+            mainHandler.post(this::showNoteRoll);
+            return;
+        }
+        if (windowManager == null) return;
+        MidiParser.MidiSong song = readCurrentSong();
+        if (song == null) {
+            toast("请先在主界面导入 MIDI 曲谱，再显示音符谱面。");
+            return;
+        }
+        currentSong = song;
+        if (noteRollView == null) {
+            noteRollView = new NoteRollView(this);
+            noteRollParams = new WindowManager.LayoutParams(
+                    WindowManager.LayoutParams.MATCH_PARENT, dp(116),
+                    WindowManager.LayoutParams.TYPE_ACCESSIBILITY_OVERLAY,
+                    WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE | WindowManager.LayoutParams.FLAG_NOT_TOUCHABLE
+                            | WindowManager.LayoutParams.FLAG_LAYOUT_IN_SCREEN,
+                    PixelFormat.TRANSLUCENT);
+            noteRollParams.gravity = Gravity.TOP | Gravity.LEFT;
+            noteRollParams.x = 0;
+            noteRollParams.y = dp(3);
+            try { windowManager.addView(noteRollView, noteRollParams); }
+            catch (Exception e) {
+                noteRollView = null;
+                noteRollParams = null;
+                toast("音符谱面无法显示，请重新开启无障碍服务后重试。");
+                return;
+            }
+        }
+        refreshNoteRollData();
+    }
+
+    private void refreshNoteRollData() {
+        if (noteRollView == null) return;
+        if (currentSong == null) currentSong = readCurrentSong();
+        if (currentSong == null) return;
+        long duration = currentSong.durationMicros;
+        long startMs = Math.max(0L, prefs.getLong(KEY_RANGE_START_MS, 0L));
+        long savedEnd = prefs.getLong(KEY_RANGE_END_MS, -1L);
+        long endMs = savedEnd > 0 ? Math.min(savedEnd, Math.max(1L, duration / 1000L)) : Math.max(1L, duration / 1000L);
+        startMs = Math.min(startMs, endMs - 1L);
+        noteRollView.setSong(currentSong, startMs * 1000L, endMs * 1000L,
+                activeSpeedPercent, playbackPositionMicros, playbackActive);
+        noteRollView.invalidate();
+    }
+
+    private void showSegmentDialog() {
+        if (Looper.myLooper() != Looper.getMainLooper()) {
+            mainHandler.post(this::showSegmentDialog);
+            return;
+        }
+        if (windowManager == null) return;
+        MidiParser.MidiSong song = readCurrentSong();
+        if (song == null) {
+            toast("请先在主界面导入 MIDI 曲谱。");
+            return;
+        }
+        currentSong = song;
+        final long songDurationMs = Math.max(1L, song.durationMicros / 1000L);
+        long savedStart = Math.max(0L, prefs.getLong(KEY_RANGE_START_MS, 0L));
+        long savedEnd = prefs.getLong(KEY_RANGE_END_MS, songDurationMs);
+        savedStart = Math.min(savedStart, songDurationMs - 1);
+        savedEnd = Math.max(savedStart + 1, Math.min(savedEnd, songDurationMs));
+        final long[] startMs = {savedStart};
+        final long[] endMs = {savedEnd};
+        final int[] speed = {prefs.getInt("playback_speed_percent", 100)};
+
+        FrameLayout root = new FrameLayout(this);
+        root.setBackgroundColor(0xc8202938);
+        int screenWidth = getResources().getDisplayMetrics().widthPixels;
+        int panelWidth = Math.min(dp(520), screenWidth - dp(28));
+        LinearLayout card = new LinearLayout(this);
+        card.setOrientation(LinearLayout.VERTICAL);
+        card.setPadding(dp(20), dp(18), dp(20), dp(18));
+        card.setBackground(rounded(0xff182433, dp(16)));
+        TextView title = new TextView(this);
+        title.setText("选择练习片段");

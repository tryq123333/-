+        Button full = smallButton("全曲");
+        Button confirm = smallButton("确定");
+        LinearLayout.LayoutParams actionParams = new LinearLayout.LayoutParams(0, dp(42), 1);
+        actionParams.setMargins(dp(3), dp(14), dp(3), 0);
+        actions.addView(preview, actionParams);
+        actions.addView(full, actionParams);
+        actions.addView(confirm, actionParams);
+        card.addView(actions, new LinearLayout.LayoutParams(-1, -2));
+        FrameLayout.LayoutParams cardParams = new FrameLayout.LayoutParams(panelWidth, -2, Gravity.CENTER);
+        root.addView(card, cardParams);
+
+        segmentOverlay = root;
+        FrameLayout.LayoutParams rootParams = new FrameLayout.LayoutParams(-1, -1);
+        root.setLayoutParams(rootParams);
+        WindowManager.LayoutParams overlayParams = new WindowManager.LayoutParams(
+                WindowManager.LayoutParams.MATCH_PARENT, WindowManager.LayoutParams.MATCH_PARENT,
+                WindowManager.LayoutParams.TYPE_ACCESSIBILITY_OVERLAY,

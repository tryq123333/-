+                PixelFormat.TRANSLUCENT);
+        overlayParams.gravity = Gravity.TOP | Gravity.LEFT;
+        // Accessibility overlays already receive gestures from the service. Keep window non-focusable.
+        try { windowManager.addView(root, overlayParams); }
+        catch (Exception e) { segmentOverlay = null; toast("练习片段面板打开失败。"); return; }
+
+        Runnable saveAndClose = () -> {
+            prefs.edit().putLong(KEY_RANGE_START_MS, startMs[0]).putLong(KEY_RANGE_END_MS, endMs[0])
+                    .putInt("playback_speed_percent", speed[0]).apply();
+            activeSpeedPercent = speed[0];
+            removeOverlay(segmentOverlay);

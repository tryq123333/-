+        title.setTypeface(null, Typeface.BOLD);
+        card.addView(title, new LinearLayout.LayoutParams(-1, -2));
+        TextView subtitle = new TextView(this);
+        subtitle.setText(song.title + " · " + formatTime(songDurationMs));
+        subtitle.setTextColor(0xffb8c9d9);
+        subtitle.setTextSize(12);
+        subtitle.setPadding(0, dp(5), 0, dp(14));
+        card.addView(subtitle);
+
+        TextView rangeText = new TextView(this);
+        rangeText.setTextColor(0xffe8eff7);
+        rangeText.setTextSize(13);
+        card.addView(rangeText);
+        SeekBar start = new SeekBar(this);
+        start.setMax((int) Math.min(Integer.MAX_VALUE, songDurationMs));
+        start.setProgress((int) startMs[0]);
+        card.addView(start, seekParams());
+        TextView endLabel = new TextView(this);
+        endLabel.setTextColor(0xffe8eff7);
+        endLabel.setTextSize(13);
+        card.addView(endLabel);
+        SeekBar end = new SeekBar(this);
+        end.setMax((int) Math.min(Integer.MAX_VALUE, songDurationMs));
+        end.setProgress((int) endMs[0]);
+        card.addView(end, seekParams());
+        Runnable updateLabels = () -> {
+            if (startMs[0] >= endMs[0]) startMs[0] = Math.max(0L, endMs[0] - 1);
+            if (endMs[0] <= startMs[0]) endMs[0] = Math.min(songDurationMs, startMs[0] + 1);
+            rangeText.setText("开始位置  " + formatTime(startMs[0]) + " / " + formatTime(songDurationMs));
+            endLabel.setText("结束位置  " + formatTime(endMs[0]) + " / " + formatTime(songDurationMs));
+            start.setProgress((int) startMs[0]);
+            end.setProgress((int) endMs[0]);
+        };
+        start.setOnSeekBarChangeListener(new SeekBar.OnSeekBarChangeListener() {
+            public void onProgressChanged(SeekBar seekBar, int value, boolean fromUser) {
+                startMs[0] = Math.min(value, endMs[0] - 1);
+                updateLabels.run();
+            }
+            public void onStartTrackingTouch(SeekBar seekBar) {}
+            public void onStopTrackingTouch(SeekBar seekBar) {}
+        });
+        end.setOnSeekBarChangeListener(new SeekBar.OnSeekBarChangeListener() {
+            public void onProgressChanged(SeekBar seekBar, int value, boolean fromUser) {
+                endMs[0] = Math.max(startMs[0] + 1, value);
+                updateLabels.run();
+            }
+            public void onStartTrackingTouch(SeekBar seekBar) {}
+            public void onStopTrackingTouch(SeekBar seekBar) {}
+        });
+        updateLabels.run();
+
+        TextView speedLabel = new TextView(this);
+        speedLabel.setTextColor(0xffe8eff7);
+        speedLabel.setTextSize(13);
+        speedLabel.setPadding(0, dp(12), 0, dp(2));
+        card.addView(speedLabel);
+        SeekBar speedBar = new SeekBar(this);
+        speedBar.setMax(150);
+        speedBar.setProgress(Math.max(0, Math.min(150, speed[0] - 50)));
+        card.addView(speedBar, seekParams());
+        speedBar.setOnSeekBarChangeListener(new SeekBar.OnSeekBarChangeListener() {
+            public void onProgressChanged(SeekBar seekBar, int value, boolean fromUser) {
+                speed[0] = value + 50;
+                speedLabel.setText("播放速度  " + (speed[0] / 100.0f) + "×");
+            }
+            public void onStartTrackingTouch(SeekBar seekBar) {}
+            public void onStopTrackingTouch(SeekBar seekBar) {}
+        });
+        speedLabel.setText("播放速度  " + (speed[0] / 100.0f) + "×");
+
